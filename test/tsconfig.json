{
	"compilerOptions": {
		"module": "ES2022",
		"target": "ES2022",
		"moduleResolution": "bundler",
		"paths": {
			"#*": [
				"../src/*"
			]
		},
		"esModuleInterop": true,
		"skipLibCheck": true,
		"strict": false,
		"rootDir": "..",
		"types": [
			"bun-types"
		]
	},
	"include": [
		".",
		"../src"
	]
}
